# Cloudflare Pages Function / Workers AI
# 실제 값은 Cloudflare Pages 환경변수 또는 로컬 .env에만 설정한다.
# 브라우저에 노출되는 VITE_ 접두사는 사용하지 않는 것을 권장한다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# 회사망 등 프록시 환경에서 dev 챗봇이 외부(api.cloudflare.com)에 연결되지 않으면
# 아래처럼 프록시를 지정한다. (보통 시스템 HTTPS_PROXY 환경변수를 자동 감지하므로 불필요)
# HTTPS_PROXY=http://proxy.example.com:8080
